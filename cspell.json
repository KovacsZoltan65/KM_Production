{
    "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
    "version": "0.2",
    "language": "en,hu,hu-hu",
    "import": ["@cspell/dict-hu-hu/cspell-ext.json"],
    "useGitignore": true,
    "enabledFileTypes": {
        "*": true,
        "markdown": false
    },
    "dictionaryDefinitions": [
        {
            "name": "km-production",
            "path": "./cspell-project-words.txt",
            "addWords": true
        }
    ],
    "dictionaries": ["km-production"],
    "words": ["inertiajs", "primevue"],
    "ignorePaths": [
        "node_modules/**",
        "vendor/**",
        "public/build/**",
        "dist/**",
        "coverage/**"
    ]
}
